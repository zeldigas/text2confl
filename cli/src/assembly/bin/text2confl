#!/usr/bin/env sh

set -eu

# Absolute path to this script, e.g. /opt/text2confl/bin/text2confl (symlinks are resolved)
SCRIPT=$(readlink -f "$0")
# Distribution root, parent of the bin directory, thus /opt/text2confl
APP_HOME=$(dirname "$(dirname "$SCRIPT")")

# On Cygwin/MSYS/Git Bash, java is a native Windows binary, so it needs a
# Windows-style path and a ';' classpath separator instead of ':'
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*)
    APP_HOME=$(cygpath -w "$APP_HOME")
    CLASSPATH="$APP_HOME\\app\\*;$APP_HOME\\lib\\*"
    ;;
  *)
    CLASSPATH="$APP_HOME/app/*:$APP_HOME/lib/*"
    ;;
esac

JAVA_VERSION=$(java -version 2>&1 | sed -n 's/.* version "\([0-9]*\).*/\1/p' | head -n 1)
EXTRA_OPTS="--enable-native-access=ALL-UNNAMED"
if [ "${JAVA_VERSION:-0}" -gt 23 ]; then
  EXTRA_OPTS="$EXTRA_OPTS --sun-misc-unsafe-memory-access=allow"
fi

java -cp "$CLASSPATH" ${JAVA_OPTS:-} $EXTRA_OPTS \
  --add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED \
  com.github.zeldigas.text2confl.cli.MainKt "$@"

